# Local laptop only. Copy to .env and keep .env out of git.
# Placeholders only. Do not reuse these values in production.
# Catalog: gym-buddy-documentation 10-Getting-started/04-Environment-and-pipeline.md

SPRING_PROFILES_ACTIVE=local
FIXTURE_SEED=20260813

# Used by compose to create the PostgreSQL 18 role. Named GYM_BUDDY_* so a
# Windows/desktop POSTGRES_PASSWORD does not override this file.
GYM_BUDDY_POSTGRES_PASSWORD=change-me-local
# Host publish ports. Uncomment if 8080 (Apache) or 5432 (local Postgres) is taken.
# API_HOST_PORT=18080
# POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql://gymbuddy:change-me-local@127.0.0.1:5432/gymbuddy

REDIS_URL=redis://127.0.0.1:6379

# HS256 signing secret. Replace before any shared environment.
JWT_ACCESS_SECRET=change-me-local-hs256-not-for-prod

S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=gym-buddy
S3_ACCESS_KEY=gymbuddy
S3_SECRET_KEY=change-me-local-minio
S3_REGION=us-east-1

# Demo handles after a local fixture seed. Placeholders only; never production secrets.
DEMO_ALEX_PASSWORD=change-me-local-demo
DEMO_BLAKE_PASSWORD=change-me-local-demo
DEMO_MOD_PASSWORD=change-me-local-demo
DEMO_ADMIN_PASSWORD=change-me-local-demo

# Live VPS only: set true once to insert missing demo.admin / demo.mod. Leave unset afterwards.
# Does not enable POST /admin/fixtures on prod.
# GYM_BUDDY_BOOTSTRAP_STAFF=true
