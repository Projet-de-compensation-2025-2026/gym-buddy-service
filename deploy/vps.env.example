# Copy to /etc/gym-buddy/vps.env on the VPS. chmod 600. Never commit the copy.
# Placeholders only. Fill values on the host. Catalog: docs/vps-data-plane.md

# Compose uses this to create the PostgreSQL 18 role. The API reads DATABASE_URL.
# Same value is the pgAdmin password for user gymbuddy (SSH tunnel, not public 5432).
POSTGRES_PASSWORD=

# Docker-network URLs (service names on gym-buddy-data). Not 127.0.0.1.
DATABASE_URL=postgresql://gymbuddy:REPLACE_ME@postgres:5432/gymbuddy
REDIS_URL=redis://redis:6379

# HS256 signing secret. Required by replace.sh. Not a committed production value.
JWT_ACCESS_SECRET=

# S3-compatible storage. SPRING_PROFILES_ACTIVE=prod refuses to start if these are blank.
SPRING_PROFILES_ACTIVE=prod
S3_ENDPOINT=http://minio:9000
S3_BUCKET=gym-buddy
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Optional one-shot staff bootstrap (ticket #78). Unset after the accounts exist.
# POST /admin/fixtures stays FORBIDDEN on prod. Placeholders only; fill on the host.
# GYM_BUDDY_BOOTSTRAP_STAFF=true
# DEMO_ADMIN_PASSWORD=
# DEMO_MOD_PASSWORD=
