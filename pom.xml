<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>fr.projetcompensation</groupId>
    <artifactId>gym-buddy-service</artifactId>
    <version>0.2.0-SNAPSHOT</version>
    <name>gym-buddy-service</name>
    <description>Gym Buddy Java API</description>

    <properties>
        <java.version>25</java.version>
        <aws.sdk.version>2.31.78</aws.sdk.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <jjwt.version>0.12.6</jjwt.version>
        <bouncycastle.version>1.81</bouncycastle.version>
        <openapi-generator.version>7.16.0</openapi-generator.version>
        <!-- gym-buddy-openapi develop SHA after ticket #62 (comments). Pin a 0.1.x tag when Release cuts one. -->
        <openapi.package.tag>01ab3d50195833296b10e8ca44aa89d1e046683a</openapi.package.tag>
        <openapi.package.dir>${project.build.directory}/openapi/gym-buddy-openapi</openapi.package.dir>
        <openapi.spec.file>${openapi.package.dir}/openapi/openapi.yaml</openapi.spec.file>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <version>${aws.sdk.version}</version>
        </dependency>
        <dependency>
            <groupId>net.coobird</groupId>
            <artifactId>thumbnailator</artifactId>
            <version>0.4.20</version>
        </dependency>
        <dependency>
            <groupId>com.twelvemonkeys.imageio</groupId>
            <artifactId>imageio-jpeg</artifactId>
            <version>3.12.0</version>
        </dependency>
        <dependency>
            <groupId>com.twelvemonkeys.imageio</groupId>
            <artifactId>imageio-webp</artifactId>
            <version>3.12.0</version>
        </dependency>
        <dependency>
            <groupId>org.sejda.imageio</groupId>
            <artifactId>webp-imageio</artifactId>
            <version>0.1.6</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.lettuce</groupId>
            <artifactId>lettuce-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>gym-buddy-service</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>fetch-openapi-package</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <exec executable="bash" failonerror="true" dir="${project.basedir}">
                                    <arg value="scripts/fetch-openapi-tree.sh"/>
                                    <arg value="${openapi.package.tag}"/>
                                    <arg value="target/openapi/gym-buddy-openapi"/>
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>${openapi-generator.version}</version>
                <executions>
                    <execution>
                        <id>generate-from-gym-buddy-openapi</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${openapi.spec.file}</inputSpec>
                            <generatorName>spring</generatorName>
                            <output>${project.build.directory}/generated-sources/openapi</output>
                            <apiPackage>fr.projetcompensation.gymbuddy.openapi.api</apiPackage>
                            <modelPackage>fr.projetcompensation.gymbuddy.openapi.model</modelPackage>
                            <invokerPackage>fr.projetcompensation.gymbuddy.openapi</invokerPackage>
                            <generateApis>true</generateApis>
                            <generateModels>true</generateModels>
                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>
                            <generateApiDocumentation>false</generateApiDocumentation>
                            <generateModelDocumentation>false</generateModelDocumentation>
                            <generateSupportingFiles>false</generateSupportingFiles>
                            <skipOverwrite>false</skipOverwrite>
                            <ignoreFileOverride>${project.basedir}/.openapi-generator-ignore</ignoreFileOverride>
                            <importMappings>
                                <importMapping>HealthStatus=fr.projetcompensation.gymbuddy.health.HealthStatus</importMapping>
                            </importMappings>
                            <schemaMappings>
                                <schemaMapping>HealthStatus=fr.projetcompensation.gymbuddy.health.HealthStatus</schemaMapping>
                            </schemaMappings>
                            <!-- File $refs on path items become inline models. Map those names to the component schemas. -->
                            <inlineSchemaNameMappings>
                                <inlineSchemaNameMapping>getHealthz_200_response=HealthStatus</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>postAuthRegister_request=RegisterRequest</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>postAuthLogin_request=LoginRequest</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>postAuthLogin_200_response=AccessTokenResponse</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>postAuthRefresh_200_response=AccessTokenResponse</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>postAuthRegister_201_response=RegisteredUser</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>postAuthRegister_409_response=ErrorResponse</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>postAuthRegister_422_response=ErrorResponse</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>postAuthRegister_409_response_error=ErrorResponseError</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>postAuthRegister_422_response_error=ErrorResponseError</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>postAuthRegister_409_response_error_details_inner=ErrorDetail</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>postAuthRegister_422_response_error_details_inner=ErrorDetail</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>postAuthPassword_request=ChangePasswordRequest</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>postMeClose_request=CloseAccountRequest</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>getProfilesMe_200_response=Profile</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>getProfilesMe_200_response_preferredWindows_inner=PreferredWindow</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>patchProfilesMe_request=PatchProfileRequest</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>patchProfilesMe_200_response=Profile</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>patchProfilesMe_200_response_preferredWindows_inner=PreferredWindow</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>getProfilesHandle_200_response=Profile</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>getProfilesHandle_200_response_preferredWindows_inner=PreferredWindow</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>postFriendships_request=CreateFriendshipRequest</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>postBlocks_request=CreateBlockRequest</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>getFriendships_200_response=FriendshipPage</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>getFriendships_200_response_data_inner=Friendship</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>getFriendships_200_response_data_inner_peer=FriendshipPeer</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>getFriendships_200_response_page=Page</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>postFriendships_201_response=Friendship</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>postFriendships_201_response_peer=FriendshipPeer</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>postFriendshipsIdAccept_200_response=Friendship</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>postFriendshipsIdAccept_200_response_peer=FriendshipPeer</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>postMedia_request=CreateMediaRequest</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>postMedia_201_response=CreateMediaResponse</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>getMediaIdUrl_200_response=MediaUrlResponse</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>postPosts_request=CreatePostRequest</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>patchPostsId_request=PatchPostRequest</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>postPosts_201_response=Post</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>postPosts_201_response_author=PostAuthor</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>getPostsId_200_response=Post</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>getPostsId_200_response_author=PostAuthor</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>patchPostsId_200_response=Post</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>patchPostsId_200_response_author=PostAuthor</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>postPostsIdReposts_201_response=Post</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>postPostsIdReposts_201_response_author=PostAuthor</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>getPostsIdLikes_200_response=PostLikerPage</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>getPostsIdLikes_200_response_data_inner=PostLiker</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>getPostsIdLikes_200_response_page=Page</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>postPostsIdComments_request=CreateCommentRequest</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>postPostsIdComments_201_response=Comment</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>postPostsIdComments_201_response_author=PostAuthor</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>getPostsIdComments_200_response=CommentPage</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>getPostsIdComments_200_response_data_inner=Comment</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>getPostsIdComments_200_response_data_inner_author=PostAuthor</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>getPostsIdComments_200_response_page=Page</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>getCommentsIdReplies_200_response=CommentPage</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>getCommentsIdReplies_200_response_data_inner=Comment</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>getCommentsIdReplies_200_response_data_inner_author=PostAuthor</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>getCommentsIdReplies_200_response_page=Page</inlineSchemaNameMapping>
                                <inlineSchemaNameMapping>Comment_author=PostAuthor</inlineSchemaNameMapping>
                            </inlineSchemaNameMappings>
                            <modelNameMappings>
                                <modelNameMapping>getHealthz_200_response=HealthStatus</modelNameMapping>
                                <modelNameMapping>postAuthRegister_request=RegisterRequest</modelNameMapping>
                                <modelNameMapping>postAuthLogin_request=LoginRequest</modelNameMapping>
                                <modelNameMapping>postAuthLogin_200_response=AccessTokenResponse</modelNameMapping>
                                <modelNameMapping>postAuthRefresh_200_response=AccessTokenResponse</modelNameMapping>
                                <modelNameMapping>postAuthRegister_201_response=RegisteredUser</modelNameMapping>
                                <modelNameMapping>postAuthRegister_409_response=ErrorResponse</modelNameMapping>
                                <modelNameMapping>postAuthRegister_422_response=ErrorResponse</modelNameMapping>
                                <modelNameMapping>postAuthRegister_409_response_error=ErrorResponseError</modelNameMapping>
                                <modelNameMapping>postAuthRegister_422_response_error=ErrorResponseError</modelNameMapping>
                                <modelNameMapping>postAuthRegister_409_response_error_details_inner=ErrorDetail</modelNameMapping>
                                <modelNameMapping>postAuthRegister_422_response_error_details_inner=ErrorDetail</modelNameMapping>
                                <modelNameMapping>postAuthPassword_request=ChangePasswordRequest</modelNameMapping>
                                <modelNameMapping>postMeClose_request=CloseAccountRequest</modelNameMapping>
                                <modelNameMapping>getProfilesMe_200_response=Profile</modelNameMapping>
                                <modelNameMapping>getProfilesMe_200_response_preferredWindows_inner=PreferredWindow</modelNameMapping>
                                <modelNameMapping>patchProfilesMe_request=PatchProfileRequest</modelNameMapping>
                                <modelNameMapping>patchProfilesMe_200_response=Profile</modelNameMapping>
                                <modelNameMapping>patchProfilesMe_200_response_preferredWindows_inner=PreferredWindow</modelNameMapping>
                                <modelNameMapping>getProfilesHandle_200_response=Profile</modelNameMapping>
                                <modelNameMapping>getProfilesHandle_200_response_preferredWindows_inner=PreferredWindow</modelNameMapping>
                                <modelNameMapping>postFriendships_request=CreateFriendshipRequest</modelNameMapping>
                                <modelNameMapping>postBlocks_request=CreateBlockRequest</modelNameMapping>
                                <modelNameMapping>getFriendships_200_response=FriendshipPage</modelNameMapping>
                                <modelNameMapping>getFriendships_200_response_data_inner=Friendship</modelNameMapping>
                                <modelNameMapping>getFriendships_200_response_data_inner_peer=FriendshipPeer</modelNameMapping>
                                <modelNameMapping>getFriendships_200_response_page=Page</modelNameMapping>
                                <modelNameMapping>postFriendships_201_response=Friendship</modelNameMapping>
                                <modelNameMapping>postFriendships_201_response_peer=FriendshipPeer</modelNameMapping>
                                <modelNameMapping>postFriendshipsIdAccept_200_response=Friendship</modelNameMapping>
                                <modelNameMapping>postFriendshipsIdAccept_200_response_peer=FriendshipPeer</modelNameMapping>
                                <modelNameMapping>postMedia_request=CreateMediaRequest</modelNameMapping>
                                <modelNameMapping>postMedia_201_response=CreateMediaResponse</modelNameMapping>
                                <modelNameMapping>getMediaIdUrl_200_response=MediaUrlResponse</modelNameMapping>
                                <modelNameMapping>postPosts_request=CreatePostRequest</modelNameMapping>
                                <modelNameMapping>patchPostsId_request=PatchPostRequest</modelNameMapping>
                                <modelNameMapping>postPosts_201_response=Post</modelNameMapping>
                                <modelNameMapping>postPosts_201_response_author=PostAuthor</modelNameMapping>
                                <modelNameMapping>getPostsId_200_response=Post</modelNameMapping>
                                <modelNameMapping>getPostsId_200_response_author=PostAuthor</modelNameMapping>
                                <modelNameMapping>patchPostsId_200_response=Post</modelNameMapping>
                                <modelNameMapping>patchPostsId_200_response_author=PostAuthor</modelNameMapping>
                                <modelNameMapping>postPostsIdReposts_201_response=Post</modelNameMapping>
                                <modelNameMapping>postPostsIdReposts_201_response_author=PostAuthor</modelNameMapping>
                                <modelNameMapping>getPostsIdLikes_200_response=PostLikerPage</modelNameMapping>
                                <modelNameMapping>getPostsIdLikes_200_response_data_inner=PostLiker</modelNameMapping>
                                <modelNameMapping>getPostsIdLikes_200_response_page=Page</modelNameMapping>
                                <modelNameMapping>postPostsIdComments_request=CreateCommentRequest</modelNameMapping>
                                <modelNameMapping>postPostsIdComments_201_response=Comment</modelNameMapping>
                                <modelNameMapping>postPostsIdComments_201_response_author=PostAuthor</modelNameMapping>
                                <modelNameMapping>getPostsIdComments_200_response=CommentPage</modelNameMapping>
                                <modelNameMapping>getPostsIdComments_200_response_data_inner=Comment</modelNameMapping>
                                <modelNameMapping>getPostsIdComments_200_response_data_inner_author=PostAuthor</modelNameMapping>
                                <modelNameMapping>getPostsIdComments_200_response_page=Page</modelNameMapping>
                                <modelNameMapping>getCommentsIdReplies_200_response=CommentPage</modelNameMapping>
                                <modelNameMapping>getCommentsIdReplies_200_response_data_inner=Comment</modelNameMapping>
                                <modelNameMapping>getCommentsIdReplies_200_response_data_inner_author=PostAuthor</modelNameMapping>
                                <modelNameMapping>getCommentsIdReplies_200_response_page=Page</modelNameMapping>
                                <modelNameMapping>Comment_author=PostAuthor</modelNameMapping>
                            </modelNameMappings>
                            <configOptions>
                                <sourceFolder>src/main/java</sourceFolder>
                                <library>spring-boot</library>
                                <interfaceOnly>true</interfaceOnly>
                                <skipDefaultInterface>true</skipDefaultInterface>
                                <useTags>true</useTags>
                                <useSpringBoot3>true</useSpringBoot3>
                                <useJakartaEe>true</useJakartaEe>
                                <useBeanValidation>true</useBeanValidation>
                                <performBeanValidation>true</performBeanValidation>
                                <openApiNullable>false</openApiNullable>
                                <documentationProvider>none</documentationProvider>
                                <annotationLibrary>none</annotationLibrary>
                                <useSwaggerUI>false</useSwaggerUI>
                                <requestMappingMode>api_interface</requestMappingMode>
                                <useSpringController>false</useSpringController>
                                <generatedConstructorWithRequiredArgs>true</generatedConstructorWithRequiredArgs>
                                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                                <dateLibrary>java8</dateLibrary>
                                <useResponseEntity>true</useResponseEntity>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>3.10.0</version>
                <configuration>
                    <java>
                        <palantirJavaFormat>
                            <version>2.80.0</version>
                        </palantirJavaFormat>
                        <removeUnusedImports/>
                    </java>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
